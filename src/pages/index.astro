---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getGamesByFilters } from '../lib/games';

export const prerender = true;

const games = await getGamesByFilters(getDatabase());
const categories = [
  ...new Map(
    games.flatMap((game) => game.category ? [[game.category.id, game.category] as const] : []),
  ).values(),
].sort((a, b) => a.name.localeCompare(b.name));
const publishers = [
  ...new Map(
    games.flatMap((game) => game.publisher ? [[game.publisher.id, game.publisher] as const] : []),
  ).values(),
].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form aria-label="Game filters" data-testid="game-filters" class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5">
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <fieldset>
                <legend class="mb-3 font-medium text-slate-100">Filter by category</legend>
                <div class="flex flex-wrap gap-x-5 gap-y-3">
                  {categories.map((category) => (
                    <label for={`category-${category.id}`} class="inline-flex items-center gap-2 text-slate-200">
                      <input
                        id={`category-${category.id}`}
                        type="checkbox"
                        name="category"
                        value={category.id}
                        data-testid={`filter-category-${category.id}`}
                        class="h-4 w-4 rounded border-slate-500 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      />
                      {category.name}
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="flex flex-col items-start gap-3">
                <label for="publisher-filter" class="font-medium text-slate-100">Filter by publisher</label>
                <select
                  id="publisher-filter"
                  name="publisher"
                  data-testid="filter-publisher"
                  class="w-full max-w-sm rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
                <button
                  type="button"
                  data-testid="clear-game-filters"
                  class="rounded-lg border border-slate-600 px-3 py-2 text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                >
                  Clear filters
                </button>
              </div>
            </div>
          </form>

          <p role="status" aria-live="polite" data-testid="filter-results-count" class="mb-4 text-slate-300">
            Showing {games.length} of {games.length} games
          </p>
          <p data-testid="filter-empty-state" class="mb-4 text-slate-300" hidden>
            No games match the selected filters.
          </p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');

  if (form && grid) {
    const categoryInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisherSelect = form.querySelector<HTMLSelectElement>('select[name="publisher"]');
    const clearButton = form.querySelector<HTMLButtonElement>('[data-testid="clear-game-filters"]');
    const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-results-count"]');
    const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const url = new URL(window.location.href);

    for (const input of categoryInputs) {
      input.checked = url.searchParams.getAll('category').includes(input.value);
    }
    if (publisherSelect) {
      publisherSelect.value = url.searchParams.get('publisher') ?? '';
    }

    const applyFilters = (): void => {
      const selectedCategories = new Set(
        categoryInputs.filter((input) => input.checked).map((input) => input.value),
      );
      const selectedPublisher = publisherSelect?.value ?? '';
      let visibleCount = 0;

      for (const card of cards) {
        const categoryMatches =
          selectedCategories.size === 0 ||
          selectedCategories.has(card.dataset.gameCategoryId ?? '');
        const publisherMatches =
          selectedPublisher === '' || selectedPublisher === (card.dataset.gamePublisherId ?? '');
        card.hidden = !(categoryMatches && publisherMatches);
        if (!card.hidden) visibleCount++;
      }

      if (resultCount) {
        resultCount.textContent = `Showing ${visibleCount} of ${cards.length} games`;
      }
      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }

      const nextUrl = new URL(window.location.href);
      nextUrl.searchParams.delete('category');
      for (const category of selectedCategories) {
        nextUrl.searchParams.append('category', category);
      }
      nextUrl.searchParams.delete('publisher');
      if (selectedPublisher) {
        nextUrl.searchParams.set('publisher', selectedPublisher);
      }
      window.history.replaceState(null, '', `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`);
    };

    for (const input of categoryInputs) {
      input.addEventListener('change', applyFilters);
    }
    publisherSelect?.addEventListener('change', applyFilters);
    clearButton?.addEventListener('click', () => {
      for (const input of categoryInputs) {
        input.checked = false;
      }
      if (publisherSelect) {
        publisherSelect.value = '';
      }
      applyFilters();
    });

    applyFilters();
  }
</script>
