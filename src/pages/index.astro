---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getAllCategories, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
        <form
          id="game-filters"
          class="mb-6 flex flex-col gap-4 rounded-xl border border-slate-700/50 bg-slate-800/60 p-4 md:flex-row md:items-start"
          data-testid="game-filters"
          aria-label="Filter games"
        >
          <fieldset class="flex-1">
            <legend class="mb-2 text-sm font-medium text-slate-300">Categories</legend>
            <div class="flex flex-wrap gap-3">
              {categories.map((category) => (
                <label class="inline-flex items-center gap-2 text-sm text-slate-200">
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid={`filter-category-${category.id}`}
                  />
                  {category.name}
                </label>
              ))}
            </div>
          </fieldset>
          <div>
            <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-300">Publisher</label>
            <select
              id="publisher-filter"
              name="publisher"
              class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="filter-publisher"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </div>
          <button
            type="reset"
            class="rounded-lg bg-slate-700 px-4 py-2 text-sm text-slate-100 hover:bg-slate-600 focus:ring-2 focus:ring-blue-500 focus:outline-none md:mt-7"
            data-testid="filter-clear"
          >
            Clear filters
          </button>
        </form>
        <p class="mb-4 text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-status"></p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
        <div class="hidden" id="no-filter-results" data-testid="no-filter-results">
          <EmptyState text="No games match the selected filters." />
        </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('game-filters') as HTMLFormElement | null;
  const status = document.querySelector<HTMLElement>('[data-testid="filter-status"]');
  const empty = document.getElementById('no-filter-results');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  function applyFilters(): void {
    if (!form) return;
    const categoryIds = new FormData(form).getAll('category').map(String);
    const publisherId = String(new FormData(form).get('publisher') ?? '');
    let visible = 0;
    for (const card of cards) {
      const match =
        (categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '')) &&
        (publisherId === '' || card.dataset.publisherId === publisherId);
      card.hidden = !match;
      if (match) visible++;
    }
    empty?.classList.toggle('hidden', visible > 0);
    if (status) status.textContent = `Showing ${visible} of ${cards.length} games`;
  }

  form?.addEventListener('change', applyFilters);
  form?.addEventListener('reset', () => setTimeout(applyFilters));
  applyFilters();
</script>
