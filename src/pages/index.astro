---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form role="search" class="mb-6" onsubmit="return false">
            <label for="game-search" class="block text-sm font-medium text-slate-300 mb-2">Search games by title</label>
            <input
              id="game-search"
              type="search"
              autocomplete="off"
              placeholder="Search by title..."
              class="w-full sm:max-w-md px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-100 placeholder-slate-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="game-search-input"
            />
          </form>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div id="search-empty" hidden role="status" aria-live="polite">
            <EmptyState text="No games match your search." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  import { matchesTitle } from '../lib/search';

  const input = document.querySelector<HTMLInputElement>('#game-search');
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const empty = document.querySelector<HTMLElement>('#search-empty');

  input?.addEventListener('input', () => {
    let visible = 0;
    grid?.querySelectorAll<HTMLElement>('[data-testid="game-card"]').forEach((card) => {
      const match = matchesTitle(card.dataset.gameTitle ?? '', input.value);
      card.hidden = !match;
      if (match) visible++;
    });
    if (grid) grid.hidden = visible === 0;
    if (empty) empty.hidden = visible !== 0;
  });
</script>
