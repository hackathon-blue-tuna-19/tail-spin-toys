---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getCatalogSummary } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const summary = await getCatalogSummary(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section aria-label="Catalog summary" class="mb-8" data-testid="catalog-summary">
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-slate-800 rounded-xl p-4 border border-slate-700">
          <dt class="text-sm text-slate-400">Total games</dt>
          <dd class="text-2xl font-medium text-slate-100" data-testid="catalog-total-games">{summary.totalGames}</dd>
        </div>
        <div class="bg-slate-800 rounded-xl p-4 border border-slate-700">
          <dt class="text-sm text-slate-400">Average rating</dt>
          <dd class="text-2xl font-medium text-slate-100" data-testid="catalog-average-rating">
            {summary.averageRating === null ? 'No ratings yet' : `${summary.averageRating.toFixed(1)} / 5`}
          </dd>
        </div>
      </dl>
    </section>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>
  </div>
</Layout>
