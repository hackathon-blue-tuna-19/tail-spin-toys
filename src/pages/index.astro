---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { sortGames } from '../lib/game-sort';

export const prerender = true;

const games = sortGames(await getAllGames(getDatabase()), 'title-asc');
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        {games.length > 0 && (
          <div class="flex flex-col gap-1">
            <label for="game-sort" class="text-sm font-medium text-slate-200">Sort games</label>
            <select
              id="game-sort"
              data-testid="game-sort"
              aria-describedby="game-sort-help"
              class="rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
              <option value="title-asc">Title (A-Z)</option>
              <option value="title-desc">Title (Z-A)</option>
              <option value="rating-desc">Star rating (highest first)</option>
            </select>
            <p id="game-sort-help" class="text-xs text-slate-400">
              Unrated games appear last when sorting by star rating.
            </p>
          </div>
        )}
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  import { sortGames, type GameSort } from '../lib/game-sort';

  const sortControl = document.querySelector<HTMLSelectElement>('[data-testid="game-sort"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');

  if (sortControl && gamesGrid) {
    const cards = Array.from(gamesGrid.querySelectorAll<HTMLAnchorElement>('[data-testid="game-card"]'));
    const games = cards.map((card) => ({
      id: Number(card.dataset.gameId),
      title: card.dataset.gameTitle ?? '',
      starRating: card.dataset.gameRating ? Number(card.dataset.gameRating) : null,
      card,
    }));

    const sortCards = (): void => {
      const selectedSort = sortControl.value;
      const sort: GameSort =
        selectedSort === 'title-desc' || selectedSort === 'rating-desc' ? selectedSort : 'title-asc';
      gamesGrid.append(...sortGames(games, sort).map((game) => game.card));
    };

    sortControl.addEventListener('change', sortCards);
  }
</script>
