---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { SORT_OPTIONS } from '../lib/sort';

export const prerender = true;

const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        {games.length > 0 && (
          <div class="flex items-center gap-2">
            <label for="sort-select" class="text-sm text-slate-300">Sort by</label>
            <select
              id="sort-select"
              data-testid="sort-select"
              class="bg-slate-800 text-slate-100 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
              {SORT_OPTIONS.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
          </div>
        )}
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  import { sortGames, type SortOption } from '../lib/sort';

  const select = document.querySelector<HTMLSelectElement>('[data-testid="sort-select"]');
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');

  select?.addEventListener('change', () => {
    if (!grid) return;
    const entries = Array.from(grid.children).map((el) => {
      const raw = el.getAttribute('data-game-rating');
      return {
        el,
        title: el.getAttribute('data-game-title') ?? '',
        starRating: raw ? Number(raw) : null,
      };
    });
    for (const { el } of sortGames(entries, select.value as SortOption)) grid.appendChild(el);
  });
</script>
