---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import GameList from '../../components/GameList.astro';
import { getDatabase } from '../../lib/db';
import { getGamesPage } from '../../lib/games';

export const prerender = true;

// Page 1 is served by index.astro at "/", so generate pages 2..N here.
export async function getStaticPaths() {
  const { totalPages } = await getGamesPage(getDatabase(), 1);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const result = await getGamesPage(getDatabase(), Number(Astro.params.page));
---

<Layout title={`Tailspin Toys - Games, page ${result.page}`}>
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <GameList result={result} />
  </div>
</Layout>
