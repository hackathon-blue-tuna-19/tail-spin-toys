---
import type { GetStaticPaths } from 'astro';
import GameCatalog from '../../components/GameCatalog.astro';
import Layout from '../../layouts/Layout.astro';
import { getDatabase } from '../../lib/db';
import { getGamesPage, GAMES_PER_PAGE } from '../../lib/games';

export const prerender = true;

export const getStaticPaths = (async () => {
  const { totalPages } = await getGamesPage(getDatabase(), 1, GAMES_PER_PAGE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}) satisfies GetStaticPaths;

const currentPage = Number(Astro.params.page);
const { games, totalPages } = await getGamesPage(getDatabase(), currentPage, GAMES_PER_PAGE);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <GameCatalog games={games} currentPage={currentPage} totalPages={totalPages} />
  </div>
</Layout>
