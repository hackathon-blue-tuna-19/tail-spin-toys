---
import { clampRating, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
}

const { rating } = Astro.props;
---

{rating !== null && (
    <div class="flex items-center">
        <span class="bg-neutral-800 text-neutral-100 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
            <span class="text-neutral-300">{formatStarRating(rating)}</span>
            {clampRating(rating).toFixed(1)}
        </span>
    </div>
)}
