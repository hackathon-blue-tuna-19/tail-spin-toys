---
import GameCard from './GameCard.astro';
import EmptyState from './EmptyState.astro';
import type { Game } from '../types/game';

interface Props {
    games: Game[];
    currentPage: number;
    totalPages: number;
}

const { games, currentPage, totalPages } = Astro.props;
const pageHref = (page: number): string => page === 1 ? '/' : `/page/${page}`;
---

<section aria-labelledby="games-heading">
  <h2 id="games-heading" class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

  {games.length === 0 ? (
    <EmptyState text="No games available at the moment." />
  ) : (
    <>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>

      {totalPages > 1 && (
        <nav
          aria-label="Game list pages"
          data-testid="pagination"
          class="mt-8 flex flex-wrap items-center justify-center gap-2"
        >
          {currentPage > 1 ? (
            <a
              href={pageHref(currentPage - 1)}
              aria-label="Previous page"
              data-testid="pagination-previous"
              class="rounded-lg border border-slate-600 px-4 py-2 text-slate-200 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
              Previous
            </a>
          ) : (
            <span class="rounded-lg border border-slate-700 px-4 py-2 text-slate-500" aria-disabled="true">
              Previous
            </span>
          )}

          {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) =>
            page === currentPage ? (
              <span
                aria-current="page"
                aria-label={`Page ${page}, current page`}
                data-testid={`pagination-current-${page}`}
                class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white"
              >
                {page}
              </span>
            ) : (
              <a
                href={pageHref(page)}
                aria-label={`Page ${page}`}
                data-testid={`pagination-page-${page}`}
                class="rounded-lg border border-slate-600 px-4 py-2 text-slate-200 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              >
                {page}
              </a>
            )
          )}

          {currentPage < totalPages ? (
            <a
              href={pageHref(currentPage + 1)}
              aria-label="Next page"
              data-testid="pagination-next"
              class="rounded-lg border border-slate-600 px-4 py-2 text-slate-200 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
              Next
            </a>
          ) : (
            <span class="rounded-lg border border-slate-700 px-4 py-2 text-slate-500" aria-disabled="true">
              Next
            </span>
          )}
        </nav>
      )}
    </>
  )}
</section>
