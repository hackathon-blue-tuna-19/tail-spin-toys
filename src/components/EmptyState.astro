---
interface Props {
    text?: string;
}

const { text } = Astro.props;
---

<div
    data-testid="empty-state"
    class="text-center py-12 bg-neutral-900/70 backdrop-blur-sm rounded-xl border border-neutral-800"
>
    {text ? (
        <p data-testid="empty-state-text" class="text-neutral-300">{text}</p>
    ) : (
        <slot />
    )}
</div>
